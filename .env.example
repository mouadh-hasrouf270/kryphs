# Production defaults. scripts/setup_local.py creates independent local-only keys.
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=
APP_ENCRYPTION_KEY=
DJANGO_ALLOWED_HOSTS=creatives.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://creatives.example.com
# Native paths; Docker overrides these to /data/...
DATABASE_PATH=
MEDIA_ROOT=
MAX_UPLOAD_BYTES=536870912
# Set only after HTTPS is verified.
SECURE_HSTS_SECONDS=0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://creatives.example.com/api/v1/google/callback/
PROVIDER_TIMEOUT=45
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=noreply@example.com
